{
  // src/content/projects/*.md 는 일반 마크다운이 아니다 — Zod로 검증되는 YAML
  // 프론트매터와, 상세 페이지가 그대로 렌더하는 원시 HTML/SVG(.detail-split, <figure>,
  // 인라인 차트)를 함께 담는다.
  //
  // 마크다운 포매터가 이 파일들을 훑으면 프론트매터를 본문으로 취급해 `title:` 을 제목으로
  // 바꾸고 닫는 `---` 를 지워 빌드를 깨뜨리며(InvalidContentEntryDataError), SVG 블록을
  // 평문으로 뭉개 차트를 소리 없이 없앤다. 실제로 두 번 발생했다.
  //
  // 그래서 마크다운 자동 포맷을 끈다. 저장·붙여넣기 어느 쪽으로도 걸리지 않게 한다.
  "[markdown]": {
    "editor.formatOnSave": false,
    "editor.formatOnPaste": false,
    "editor.formatOnType": false,
    "editor.defaultFormatter": null
  },

  // 프론트매터의 하드 개행이 사라지지 않도록 마크다운은 공백 정리도 하지 않는다.
  "[yaml]": {
    "editor.formatOnSave": false
  }
}

---
// 판독창(readout) 수치는 모두 출처가 있는 실측치. 장식용 숫자를 넣지 않는다 (DESIGN-instrument.md).
const readouts = [
  { label: 'MICRO-F1 · 특허 188 중분류', value: '0.8660', note: '재현한 비교선 대비 +1.60pt', signal: false },
  { label: 'CI95 · PAIRED BOOTSTRAP', value: '+1.19 ~ +2.00', note: '개선폭을 구간과 함께 보고', signal: true },
  { label: '제공 분할에서 실측한 누수', value: '7,822', note: '학습·검증에 겹친 문서 수', signal: false },
  { label: '청구항 절단 손실', value: '42% → 1.6%', note: '512 → 4,096 토큰 인코더', signal: false },
];
---

<section class="hero sec-close" id="hero">
  <div class="wrap">
    <div class="hero-grid frame">
      <div class="hero-text">
        <div class="hero-kicker">01 — 측정 대상을 먼저 정의합니다</div>
        <h1 class="hero-title">점수를 올리기 전에 그 점수가 무엇을 재는지 확인합니다.</h1>
        <p class="hero-sub">정형·비정형 데이터를 모델링부터 배포까지 책임지는 데이터 분석가. 경제학 석사·은행 여신 실무를 거쳐 전환했고, 평가 설계를 먼저 의심하는 습관을 가장 큰 자산으로 씁니다.</p>
        <div class="hero-cta">
          <a href="#work" class="btn-fill">프로젝트 →</a>
          <a href="https://github.com/buzziru" target="_blank" rel="noopener" class="btn-line">GITHUB ↗</a>
        </div>
      </div>
      <div>
        {readouts.map((r) => (
          <div class="readout">
            <div class="readout-label">{r.label}</div>
            <div class={r.signal ? 'readout-value is-signal' : 'readout-value'}>{r.value}</div>
            <div class="readout-note">{r.note}</div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

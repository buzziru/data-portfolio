---
import { getCollection } from 'astro:content';

// 데이터는 src/data/timeline.yaml 에서 관리합니다.
const entries = await getCollection('timeline');
const items = entries.map((e) => e.data).sort((a, b) => a.order - b.order);
---

<section id="log">
  <div class="wrap">
    <div class="rail-grid frame sec-close">
      <div class="rail">LOG</div>
      <div class="reveal">
        {items.map((it) => (
          <div class="log-row" data-state={it.state}>
            <div class="log-date">{it.date}</div>
            <div>
              <div class="log-title">{it.title}</div>
              <div class="log-org">{it.org}</div>
              <p class="log-desc" set:html={it.desc}></p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

---
import { getCollection } from 'astro:content';

// 데이터는 src/data/skills.yaml 에서 관리합니다.
const entries = await getCollection('skills');
const rows = entries.map((e) => e.data).sort((a, b) => a.order - b.order);
---

<section id="stack" class="sec-sunk sec-close">
  <div class="wrap">
    <div class="rail-grid frame">
      <div class="rail">STACK</div>
      <div class="reveal">
        {rows.map((s) => (
          <div class="stack-row">
            <div>
              <div class="stack-label" data-level={s.level}>{s.label}</div>
              <div class="stack-note">{s.note}</div>
            </div>
            <p class="stack-items">{s.items}</p>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

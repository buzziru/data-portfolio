---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectThumb from '../../components/ProjectThumb';
import { joinWithDot, noBreakInside } from '../../lib/text';

export async function getStaticPaths() {
  const entries = await getCollection('projects');
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const d = entry.data;

// harness 제목만 "ML 하니스 —" / "Agentic ML 파이프라인" 두 줄로 표시
const titleHtml = entry.id === 'harness' ? d.title.replace(' — ', ' —<br>') : null;

const STATUS_LABEL: Record<string, string> = {
  completed: 'COMPLETED',
  progress: 'IN PROGRESS',
  planned: 'PLANNED',
};
---

<BaseLayout title={`${d.title} — Research Notebook`} description={d.summary.replace(/<br\s*\/?>/gi, ' ')}>
  <main class="detail-main">
    <div class="wrap">
      <a class="detail-back" href="/#projects">← 프로젝트 목록으로</a>

      <div class="detail-head-grid">
        <div class="detail-head-left">
          <div class="detail-kicker">CASE {String(d.order).padStart(2, '0')} · {d.domain}</div>
          {titleHtml ? <h1 class="detail-title" set:html={titleHtml} /> : <h1 class="detail-title">{d.title}</h1>}
          <span class="detail-status" data-status={d.status}>{STATUS_LABEL[d.status]}</span>
          <p class="detail-summary" set:html={d.summary} />
          <p class="detail-metric mono">{d.keyMetric}</p>

          <dl class="detail-meta">
            {d.date && <div><dt>Date</dt><dd>{d.date}</dd></div>}
            <div><dt>Domain</dt><dd>{d.domain}</dd></div>
            <div><dt>Role</dt><dd>{d.role}</dd></div>
            <div><dt>Methods</dt><dd>{joinWithDot(d.methods)}</dd></div>
            <div><dt>Tools</dt><dd>{d.tools.map(noBreakInside).join(', ')}</dd></div>
          </dl>

          {(d.github || d.demo) && (
            <div class="detail-actions">
              {d.demo && <a class="link-strong" href={d.demo} target="_blank" rel="noopener">LIVE DEMO ↗</a>}
              {d.github && <a class="link-quiet" href={d.github} target="_blank" rel="noopener">GITHUB ↗</a>}
            </div>
          )}
        </div>
        <div class="detail-thumb-lg">
          {d.image
            ? <img src={d.image} alt={`${d.title} 데모 대시보드`} loading="lazy" />
            : <ProjectThumb thumb={d.thumb} />}
        </div>
      </div>

      <article class="detail-body">
        <Content />
      </article>

      {d.demo && (
        <section class="detail-demo">
          <div class="detail-demo-head">
            <span class="detail-demo-kicker mono">LIVE DEMO</span>
            <a class="detail-demo-ext mono" href={d.demo} target="_blank" rel="noopener">새 탭에서 열기 ↗</a>
          </div>
          {/* demoNote 는 절 경계를 <br> 로 직접 끊는다(한국어 줄바꿈 규칙) — 이스케이프하면 태그가 그대로 보인다 */}
          <p class="detail-demo-note" set:html={d.demoNote ?? '브라우저 안에서 ONNX 모델이 직접 추론합니다 — 서버 없음. 고객 정보를 입력하면 이탈 확률을 즉시 예측합니다.'}></p>
          <div class="detail-demo-frame">
            <iframe id="demo-frame" src={d.demo} title={`${d.title} 인터랙티브 데모`} loading="lazy"></iframe>
          </div>
        </section>
      )}
    </div>
  </main>

  {d.demo && (
    <script type="module" define:vars={{ demoOrigin: new URL(d.demo).origin }}>
      // 데모(iframe)가 보내는 콘텐츠 높이에 맞춰 iframe 높이를 동기화 (내부 스크롤 제거)
      window.addEventListener('message', (e) => {
        if (e.origin !== demoOrigin) return;
        const data = e.data;
        if (data && typeof data.type === 'string' && data.type.endsWith('-demo-height') && typeof data.height === 'number') {
          const frame = document.getElementById('demo-frame');
          if (frame) frame.style.height = Math.ceil(data.height) + 'px';
        }
      });
    </script>
  )}
</BaseLayout>
